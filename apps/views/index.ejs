<% if (typeof isPartial !== 'undefined' && isPartial) { %>
    <!-- HTMX PARTIAL: Chỉ trả về nội dung cốt lõi của bài viết, không bọc thêm bất kỳ thẻ nào -->
    <% if (articles.length > 0) { %>
        <% if (currentPage === 1) { %>
            <section class="featured-section">
                <h2 class="section-title">Gợi ý từ PurePick <i data-lucide="flame" style="color: #f43f5e;"></i></h2>
                <div class="featured-card">
                    <div class="featured-thumb">
                        <a href="/post/<%= articles[0].slug %>">
                            <% if (articles[0].thumbnail) { %><img src="<%= articles[0].thumbnail %>" alt="<%= articles[0].title %>"><% } else { %><div class="no-thumb"><i data-lucide="image-off"></i></div><% } %>
                        </a>
                        <% if (articles[0].category) { %><span class="card-badge"><%= articles[0].category === 'skincare' ? 'CHĂM SÓC DA' : articles[0].category === 'makeup' ? 'TRANG ĐIỂM' : articles[0].category.toUpperCase() %></span><% } %>
                        <div class="featured-excerpt-overlay desktop-only"><%= articles[0].excerpt || (articles[0].content ? articles[0].content.replace(/<[^>]*>?/gm, '').substring(0, 180) + '...' : '') %></div>
                    </div>
                    <div class="featured-content">
                        <h2><a href="/post/<%= articles[0].slug %>"><%= articles[0].title %></a></h2>
                        <p class="featured-excerpt-mobile mobile-only"><%= articles[0].excerpt || (articles[0].content ? articles[0].content.replace(/<[^>]*>?/gm, '').substring(0, 180) + '...' : '') %></p>
                        <div class="article-meta">
                            <span class="article-date"><i data-lucide="tag" size="16"></i> <%= articles[0].skin_type === 'oily' ? 'Da dầu' : articles[0].skin_type === 'dry' ? 'Da khô' : articles[0].skin_type === 'sensitive' ? 'Da nhạy cảm' : 'Mọi loại da' %></span>
                            <a href="/post/<%= articles[0].slug %>" class="read-more" style="display: flex;">Xem chi tiết <i data-lucide="arrow-right" size="16"></i></a>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <% if ((currentPage === 1 && articles.length > 1) || (currentPage > 1 && articles.length > 0)) { %>
            <section class="latest-section">
                <% if (currentPage === 1) { %>
                    <h2 class="section-title">Review Mới Nhất <i data-lucide="clock" style="color: var(--primary-color);"></i></h2>
                <% } else { %>
                    <h2 class="section-title">Trang <%= currentPage %></h2>
                <% } %>
                <div class="articles-grid">
                    <% let startIndex = (currentPage === 1) ? 1 : 0; %>
                    <% for(let i = startIndex; i < articles.length; i++) { const article = articles[i]; %>
                        <article class="article-card">
                            <div class="article-thumb">
                                <a href="/post/<%= article.slug %>">
                                    <% if (article.thumbnail) { %><img src="<%= article.thumbnail %>" alt="<%= article.title %>"><% } else { %><div class="no-thumb"><i data-lucide="image-off"></i></div><% } %>
                                </a>
                                <% if (article.category) { %><span class="card-badge"><%= article.category === 'skincare' ? 'CHĂM SÓC DA' : article.category === 'makeup' ? 'TRANG ĐIỂM' : article.category.toUpperCase() %></span><% } %>
                                <div class="article-excerpt desktop-only"><%= article.excerpt || (article.content ? article.content.replace(/<[^>]*>?/gm, '').substring(0, 120) + '...' : '') %></div>
                            </div>
                            <div class="article-card-content">
                                <h2><a href="/post/<%= article.slug %>"><%= article.title %></a></h2>
                                <p class="article-excerpt-mobile mobile-only"><%= article.excerpt || (article.content ? article.content.replace(/<[^>]*>?/gm, '').substring(0, 120) + '...' : '') %></p>
                                <div class="article-meta"><span class="article-date"><i data-lucide="tag" size="16"></i> <%= article.skin_type === 'oily' ? 'Da dầu' : article.skin_type === 'dry' ? 'Da khô' : article.skin_type === 'sensitive' ? 'Da nhạy cảm' : 'Mọi loại da' %></span></div>
                            </div>
                        </article>
                    <% } %>
                </div>
            </section>
        <% } %>
        
        <% if (totalPages > 1) { %>
            <div class="pagination-container" style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem;">
                <% if (currentPage > 1) { %>
                    <!-- Nút về Trang Đầu -->
                    <button class="pagination-btn" hx-get="/?page=1&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang đầu"><i data-lucide="chevrons-left"></i></button>

                    <!-- Nút Lùi 1 trang -->
                    <button class="pagination-btn" hx-get="/?page=<%= currentPage - 1 %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang trước"><i data-lucide="chevron-left"></i></button>
                <% } %>

                <!-- Rút gọn trang (Ellipsis Logic) -->
                <% 
                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(totalPages, currentPage + 2);

                if (currentPage <= 3) {
                    endPage = Math.min(totalPages, 5);
                }
                if (currentPage >= totalPages - 2) {
                    startPage = Math.max(1, totalPages - 4);
                }
                %>

                <% if (startPage > 1) { %>
                    <button class="pagination-btn" disabled style="background: transparent; border: none; cursor: default;">...</button>
                <% } %>

                <% for(let p = startPage; p <= endPage; p++) { %>
                    <button class="pagination-btn <%= p === currentPage ? 'active' : '' %>" hx-get="/?page=<%= p %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true"><%= p %></button>
                <% } %>

                <% if (endPage < totalPages) { %>
                    <button class="pagination-btn" disabled style="background: transparent; border: none; cursor: default;">...</button>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <!-- Nút Tiến 1 trang -->
                    <button class="pagination-btn" hx-get="/?page=<%= currentPage + 1 %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang sau"><i data-lucide="chevron-right"></i></button>

                    <!-- Nút Tới Trang Cuối -->
                    <button class="pagination-btn" hx-get="/?page=<%= totalPages %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang cuối"><i data-lucide="chevrons-right"></i></button>
                <% } %>
            </div>
        <% } %>
    <% } else { %>
        <div class="empty-state glass" style="padding: 5rem; border-radius: var(--radius);">
            <i data-lucide="frown" size="48" style="color: var(--text-muted); margin-bottom: 1rem;"></i>
            <h2>Rất tiếc, không tìm thấy sản phẩm phù hợp</h2>
            <p>Thử thay đổi các lựa chọn lọc để tìm thấy nhiều kết quả hơn nhé!</p>
            <a href="/" class="btn-primary" style="margin-top: 1.5rem; display: inline-flex;">Xem tất cả bài viết</a>
        </div>
    <% } %>
<% } else { %>
    <!-- FULL PAGE: Chỉ chạy khi người dùng vào trang lần đầu hoặc F5 -->
    <%- include('partials/header') %>

    <script>
        function selectCategory(catId) {
            const input = document.getElementById('hidden-category-input');
            input.value = (input.value === catId) ? 'all' : catId;
            htmx.trigger('#filter-form', 'submit');
        }

        document.addEventListener('htmx:afterSettle', function(evt) {
            if (typeof lucide !== 'undefined') lucide.createIcons();
            const urlParams = new URLSearchParams(window.location.search);
            const currentCat = urlParams.get('category') || 'all';
            document.querySelectorAll('.cat-card').forEach(card => {
                card.classList.toggle('active', card.getAttribute('data-category') === currentCat);
            });
            document.getElementById('hidden-category-input').value = currentCat;
        });
    </script>

    <div class="quick-categories-wrapper" id="quick-categories-wrapper" hx-preserve="true">
        <div class="container">
            <div class="quick-categories">
                <% 
                const categories = [
                    { id: 'skincare', name: 'Dưỡng Da', icon: 'droplets' },
                    { id: 'makeup', name: 'Trang Điểm', icon: 'sparkles' },
                    { id: 'bodycare', name: 'Cơ Thể', icon: 'sun' },
                    { id: 'haircare', name: 'Tóc', icon: 'wind' },
                    { id: 'perfume', name: 'Nước Hoa', icon: 'flower' },
                    { id: 'tools', name: 'Dụng Cụ', icon: 'scissors' },
                    { id: 'supplements', name: 'Thực Phẩm', icon: 'pill' }
                ];
                %>
                <% categories.forEach(cat => { %>
                    <div class="cat-card <%= (typeof filters !== 'undefined' && filters.category === cat.id) ? 'active' : '' %>" 
                         data-category="<%= cat.id %>" onclick="selectCategory('<%= cat.id %>')" style="cursor: pointer;">
                        <div class="cat-icon"><i data-lucide="<%= cat.icon %>"></i></div>
                        <span><%= cat.name %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="container">
        <section class="compact-filter-section" id="compact-filter-section" hx-preserve="true">
            <form action="/" method="GET" id="filter-form"
                  hx-get="/" hx-trigger="submit, keyup from:#keyword-search-unified delay:400ms changed" 
                  hx-target="#search-results" hx-swap="innerHTML show:no-scroll" hx-push-url="true">
                <input type="hidden" name="category" id="hidden-category-input" value="<%= (typeof filters !== 'undefined' && filters.category) ? filters.category : 'all' %>">
                
                <div class="mobile-filter-toggle" onclick="this.parentNode.querySelector('.filter-row').classList.toggle('show'); this.querySelector('.toggle-icon').classList.toggle('rotate');">
                    <div style="display:flex; align-items:center; gap:0.5rem;"><i data-lucide="filter" size="18"></i><span>Lọc nhanh sản phẩm</span></div>
                    <i data-lucide="chevron-down" size="18" class="toggle-icon"></i>
                </div>

                <div class="filter-row">
                    <!-- Search Input -->
                    <div class="filter-search-container">
                        <div class="filter-input-unified">
                            <i data-lucide="search" size="18" style="color: var(--text-muted); margin-right: 0.75rem;"></i>
                            <input type="text" name="keyword" id="keyword-search-unified" placeholder="Tìm tên sản phẩm..." value="<%= (typeof filters !== 'undefined' && filters.keyword) ? filters.keyword : '' %>" autocomplete="off">
                        </div>
                    </div>
                    
                    <!-- Custom Select: Skin Type -->
                    <div class="custom-select-wrapper" id="skin-type-wrapper">
                        <div class="filter-input-unified custom-select-trigger-unified">
                            <span><%= (typeof filters !== 'undefined' && filters.skin_type === 'oily') ? 'Da dầu' : (typeof filters !== 'undefined' && filters.skin_type === 'dry') ? 'Da khô' : (typeof filters !== 'undefined' && filters.skin_type === 'sensitive') ? 'Da nhạy cảm' : 'Mọi loại da' %></span>
                            <i data-lucide="chevron-down" size="18"></i>
                        </div>
                        <div class="custom-options-list">
                            <div class="custom-option <%= (!locals.filters || !filters.skin_type || filters.skin_type === 'all') ? 'selected' : '' %>" data-value="all">Mọi loại da</div>
                            <div class="custom-option <%= (typeof filters !== 'undefined' && filters.skin_type === 'oily') ? 'selected' : '' %>" data-value="oily">Da dầu</div>
                            <div class="custom-option <%= (typeof filters !== 'undefined' && filters.skin_type === 'dry') ? 'selected' : '' %>" data-value="dry">Da khô</div>
                            <div class="custom-option <%= (typeof filters !== 'undefined' && filters.skin_type === 'sensitive') ? 'selected' : '' %>" data-value="sensitive">Da nhạy cảm</div>
                        </div>
                        <input type="hidden" name="skin_type" value="<%= (typeof filters !== 'undefined' && filters.skin_type) ? filters.skin_type : 'all' %>">
                    </div>

                    <!-- Custom Select: Price Range -->
                    <div class="custom-select-wrapper" id="price-range-wrapper">
                        <div class="filter-input-unified custom-select-trigger-unified">
                            <span><%= (typeof filters !== 'undefined' && filters.price_range === 'budget') ? 'Dưới 200k' : (typeof filters !== 'undefined' && filters.price_range === 'mid-range') ? '200k - 500k' : (typeof filters !== 'undefined' && filters.price_range === 'luxury') ? 'Trên 500k' : 'Mọi mức giá' %></span>
                            <i data-lucide="chevron-down" size="18"></i>
                        </div>
                        <div class="custom-options-list">
                            <div class="custom-option <%= (!locals.filters || !filters.price_range || filters.price_range === 'all') ? 'selected' : '' %>" data-value="all">Mọi mức giá</div>
                            <div class="custom-option <%= (typeof filters !== 'undefined' && filters.price_range === 'budget') ? 'selected' : '' %>" data-value="budget">Dưới 200k</div>
                            <div class="custom-option <%= (typeof filters !== 'undefined' && filters.price_range === 'mid-range') ? 'selected' : '' %>" data-value="mid-range">200k - 500k</div>
                            <div class="custom-option <%= (typeof filters !== 'undefined' && filters.price_range === 'luxury') ? 'selected' : '' %>" data-value="luxury">Trên 500k</div>
                        </div>
                        <input type="hidden" name="price_range" value="<%= (typeof filters !== 'undefined' && filters.price_range) ? filters.price_range : 'all' %>">
                    </div>
                </div>
            </form>
        </section>

        <!-- ĐÍCH ĐẾN DUY NHẤT CỦA MỌI BỘ LỌC -->
        <div id="search-results" style="min-height: 60vh;">
            <% if (articles.length > 0) { %>
                <% if (currentPage === 1) { %>
                    <section class="featured-section">
                        <h2 class="section-title">Gợi ý từ PurePick <i data-lucide="flame" style="color: #f43f5e;"></i></h2>
                        <div class="featured-card">
                            <div class="featured-thumb">
                                <a href="/post/<%= articles[0].slug %>">
                                    <% if (articles[0].thumbnail) { %><img src="<%= articles[0].thumbnail %>" alt="<%= articles[0].title %>"><% } else { %><div class="no-thumb"><i data-lucide="image-off"></i></div><% } %>
                                </a>
                                <% if (articles[0].category) { %><span class="card-badge"><%= articles[0].category === 'skincare' ? 'CHĂM SÓC DA' : articles[0].category === 'makeup' ? 'TRANG ĐIỂM' : articles[0].category.toUpperCase() %></span><% } %>
                                <div class="featured-excerpt-overlay desktop-only"><%= articles[0].excerpt || (articles[0].content ? articles[0].content.replace(/<[^>]*>?/gm, '').substring(0, 180) + '...' : '') %></div>
                            </div>
                            <div class="featured-content">
                                <h2><a href="/post/<%= articles[0].slug %>"><%= articles[0].title %></a></h2>
                                <p class="featured-excerpt-mobile mobile-only"><%= articles[0].excerpt || (articles[0].content ? articles[0].content.replace(/<[^>]*>?/gm, '').substring(0, 180) + '...' : '') %></p>
                                <div class="article-meta">
                                    <span class="article-date"><i data-lucide="tag" size="16"></i> <%= articles[0].skin_type === 'oily' ? 'Da dầu' : articles[0].skin_type === 'dry' ? 'Da khô' : articles[0].skin_type === 'sensitive' ? 'Da nhạy cảm' : 'Mọi loại da' %></span>
                                    <a href="/post/<%= articles[0].slug %>" class="read-more" style="display: flex;">Xem chi tiết <i data-lucide="arrow-right" size="16"></i></a>
                                </div>
                            </div>
                        </div>
                    </section>
                <% } %>

                <% if ((currentPage === 1 && articles.length > 1) || (currentPage > 1 && articles.length > 0)) { %>
                    <section class="latest-section">
                        <% if (currentPage === 1) { %>
                            <h2 class="section-title">Review Mới Nhất <i data-lucide="clock" style="color: var(--primary-color);"></i></h2>
                        <% } else { %>
                            <h2 class="section-title">Trang <%= currentPage %></h2>
                        <% } %>
                        <div class="articles-grid">
                            <% let startIndex = (currentPage === 1) ? 1 : 0; %>
                            <% for(let i = startIndex; i < articles.length; i++) { const article = articles[i]; %>
                                <article class="article-card">
                                    <div class="article-thumb">
                                        <a href="/post/<%= article.slug %>">
                                            <% if (article.thumbnail) { %><img src="<%= article.thumbnail %>" alt="<%= article.title %>"><% } else { %><div class="no-thumb"><i data-lucide="image-off"></i></div><% } %>
                                        </a>
                                        <% if (article.category) { %><span class="card-badge"><%= article.category === 'skincare' ? 'CHĂM SÓC DA' : article.category === 'makeup' ? 'TRANG ĐIỂM' : article.category.toUpperCase() %></span><% } %>
                                        <div class="article-excerpt desktop-only"><%= article.excerpt || (article.content ? article.content.replace(/<[^>]*>?/gm, '').substring(0, 120) + '...' : '') %></div>
                                    </div>
                                    <div class="article-card-content">
                                        <h2><a href="/post/<%= article.slug %>"><%= article.title %></a></h2>
                                        <p class="article-excerpt-mobile mobile-only"><%= article.excerpt || (article.content ? article.content.replace(/<[^>]*>?/gm, '').substring(0, 120) + '...' : '') %></p>
                                        <div class="article-meta"><span class="article-date"><i data-lucide="tag" size="16"></i> <%= article.skin_type === 'oily' ? 'Da dầu' : article.skin_type === 'dry' ? 'Da khô' : article.skin_type === 'sensitive' ? 'Da nhạy cảm' : 'Mọi loại da' %></span></div>
                                    </div>
                                </article>
                            <% } %>
                        </div>
                    </section>
                <% } %>
                
                <% if (totalPages > 1) { %>
                    <div class="pagination-container" style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem;">
                        <% if (currentPage > 1) { %>
                            <!-- Nút về Trang Đầu -->
                            <button class="pagination-btn" hx-get="/?page=1&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang đầu"><i data-lucide="chevrons-left"></i></button>

                            <!-- Nút Lùi 1 trang -->
                            <button class="pagination-btn" hx-get="/?page=<%= currentPage - 1 %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang trước"><i data-lucide="chevron-left"></i></button>
                        <% } %>
                        
                        <!-- Rút gọn trang (Ellipsis Logic) -->
                        <% 
                        let startPage = Math.max(1, currentPage - 2);
                        let endPage = Math.min(totalPages, currentPage + 2);

                        if (currentPage <= 3) {
                            endPage = Math.min(totalPages, 5);
                        }
                        if (currentPage >= totalPages - 2) {
                            startPage = Math.max(1, totalPages - 4);
                        }
                        %>

                        <% if (startPage > 1) { %>
                            <button class="pagination-btn" disabled style="background: transparent; border: none; cursor: default;">...</button>
                        <% } %>

                        <% for(let p = startPage; p <= endPage; p++) { %>
                            <button class="pagination-btn <%= p === currentPage ? 'active' : '' %>" hx-get="/?page=<%= p %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true"><%= p %></button>
                        <% } %>

                        <% if (endPage < totalPages) { %>
                            <button class="pagination-btn" disabled style="background: transparent; border: none; cursor: default;">...</button>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <!-- Nút Tiến 1 trang -->
                            <button class="pagination-btn" hx-get="/?page=<%= currentPage + 1 %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang sau"><i data-lucide="chevron-right"></i></button>

                            <!-- Nút Tới Trang Cuối -->
                            <button class="pagination-btn" hx-get="/?page=<%= totalPages %>&category=<%= filters.category || '' %>&skin_type=<%= filters.skin_type || '' %>&price_range=<%= filters.price_range || '' %>&keyword=<%= filters.keyword || '' %>" hx-target="#search-results" hx-swap="innerHTML show:window:top" hx-push-url="true" title="Trang cuối"><i data-lucide="chevrons-right"></i></button>
                        <% } %>
                    </div>
                <% } %>
                
            <% } else { %>
                <div class="empty-state glass" style="padding: 5rem; border-radius: var(--radius);">
                    <i data-lucide="frown" size="48" style="color: var(--text-muted); margin-bottom: 1rem;"></i>
                    <h2>Rất tiếc, không tìm thấy sản phẩm phù hợp</h2>
                    <p>Thử thay đổi các lựa chọn lọc để tìm thấy nhiều kết quả hơn nhé!</p>
                    <a href="/" class="btn-primary" style="margin-top: 1.5rem; display: inline-flex;">Xem tất cả bài viết</a>
                </div>
            <% } %>
        </div>
    </div>
    <%- include('partials/footer') %>
<% } %>