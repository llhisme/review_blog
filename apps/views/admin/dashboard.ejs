<% if (!onlyContent) { %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Panel</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
        :root {
            --admin-sidebar-width: 280px;
        }

        body.admin-body {
            background: var(--bg-color);
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: var(--admin-sidebar-width);
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            color: white;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-brand {
            padding: 2.5rem 2rem;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-light);
            display: flex;
            align-items: center; gap: 0.75rem;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1rem 1.25rem;
            flex-grow: 1;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .sidebar-menu a:hover, .sidebar-menu a.active {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        .sidebar-menu a.active {
            background: var(--primary-color);
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
        }

        .sidebar-footer {
            padding: 2rem 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: #fb7185;
            text-decoration: none;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.2s;
        }

        .logout-link:hover {
            background: rgba(251, 113, 133, 0.1);
        }

        /* Main Content */
        .admin-main {
            flex-grow: 1;
            margin-left: var(--admin-sidebar-width);
            padding: 3rem;
            width: 100%;
        }

        .admin-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
        }

        .admin-topbar h2 {
            font-size: 1.8rem;
            font-weight: 800;
        }

        .admin-card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 2.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
            border: 1px solid rgba(0, 0, 0, 0.03);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: var(--white);
            padding: 2rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(0, 0, 0, 0.03);
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1.5rem;
        }

        .stat-info h3 {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .stat-info p {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--text-color);
        }

        .thumb-preview {
            width: 80px;
            height: 50px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
        }

        .admin-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 0.75rem;
        }

        .admin-table th {
            text-align: left;
            padding: 1rem 1.5rem;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .admin-table tr:not(thead tr) {
            background: var(--white);
            transition: all 0.2s;
        }

        .admin-table td {
            padding: 1.25rem 1.5rem;
            border-top: 1px solid #f3f4f6;
            border-bottom: 1px solid #f3f4f6;
        }

        .admin-table td:first-child {
            border-left: 1px solid #f3f4f6;
            border-radius: 16px 0 0 16px;
        }

        .admin-table td:last-child {
            border-right: 1px solid #f3f4f6;
            border-radius: 0 16px 16px 0;
        }

        .badge {
            padding: 0.5rem 1rem;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .badge-success { 
            background: #dcfce7; 
            color: #166534; 
        }

        .action-buttons {
            display: flex;
            gap: 0.75rem;
        }

        .btn-action {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-view { background: #f3f4f6; color: var(--text-color); }
        .btn-edit { background: rgba(99, 102, 241, 0.1); color: var(--primary-color); }
        .btn-delete { background: rgba(244, 63, 94, 0.1); color: #f43f5e; }

        .btn-action:hover {
            transform: scale(1.1);
        }

        .btn-primary {
            background: var(--primary-color);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 15px 25px rgba(99, 102, 241, 0.3);
        }

        .alert {
            padding: 1.25rem 2rem;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            gap: 1rem;
            font-weight: 600;
            margin-bottom: 2rem;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        @media (max-width: 1024px) {
            .admin-sidebar { 
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .admin-sidebar.sidebar-open {
                transform: translateX(0);
            }
            .admin-main { margin-left: 0; padding: 1.5rem; }
        }

        .admin-toggle-btn {
            display: none;
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: white;
            color: var(--text-color);
            align-items: center;
            justify-content: center;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            z-index: 990;
        }

        .sidebar-overlay.active { display: block; }

        @media (max-width: 1024px) {
            .admin-toggle-btn { display: flex; }
        }

        .btn-page {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            background: white;
            color: var(--text-color);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-page:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .btn-page.active {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
        }

        @media (max-width: 640px) {
            .hide-mobile { display: none !important; }
        }
    </style>
</head>
<body class="admin-body">
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="sidebar-brand">
            <i data-lucide="sparkles"></i> <span>PurePick Admin</span>
        </div>
        <nav class="sidebar-menu">
            <a href="/admin/dashboard" class="active">
                <i data-lucide="layout-dashboard"></i> <span>Dashboard</span>
            </a>
            <a href="/admin/new">
                <i data-lucide="plus-circle"></i> <span>Viết bài mới</span>
            </a>
            <a href="/" target="_blank">
                <i data-lucide="external-link"></i> <span>Xem Website</span>
            </a>
        </nav>
        <div class="sidebar-footer">
            <a href="/admin/logout" class="logout-link">
                <i data-lucide="log-out"></i> <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button class="admin-toggle-btn" id="admin-toggle-btn">
                    <i data-lucide="menu"></i>
                </button>
                <h2>Hệ thống quản lý PurePick</h2>
            </div>
            
            <!-- Bộ lọc thời gian -->
            <div style="display: flex; align-items: center; gap: 1rem; background: white; padding: 0.5rem 1rem; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: var(--shadow-sm);">
                <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;"><i data-lucide="calendar" size="14" style="vertical-align: middle;"></i> Thời gian:</span>
                <input type="date" 
                       id="stat-date-picker" 
                       value="<%= selectedDate %>" 
                       style="border: none; outline: none; font-family: inherit; font-weight: 600; color: var(--primary-color); cursor: pointer;"
                       hx-get="/admin/dashboard"
                       hx-trigger="change"
                       hx-target="#dashboard-content"
                       hx-select="#dashboard-content"
                       name="date">
                <div style="width: 1px; height: 20px; background: #e2e8f0;"></div>
                <button hx-get="/admin/dashboard" 
                        hx-target="#dashboard-content" 
                        hx-select="#dashboard-content"
                        class="btn-all-time"
                        style="background: none; border: none; font-size: 0.85rem; font-weight: 700; color: <%= !selectedDate ? '#e11d48' : 'var(--text-muted)' %>; cursor: pointer; transition: color 0.2s;">
                    Tất cả thời gian
                </button>
            </div>

            <div class="user-info" style="display: flex; align-items: center; gap: 1rem;">
                <div style="text-align: right;" class="hide-mobile">
                    <div style="font-weight: 700; color: var(--text-color);">Quản trị viên</div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Cấp cao</div>
                </div>
                <div style="width: 45px; height: 45px; border-radius: 12px; background: var(--primary-color); display: flex; align-items: center; justify-content: center; color: white;">
                    <i data-lucide="shield-check"></i>
                </div>
            </div>
        </div>
<% } %>

        <!-- Vùng chứa nội dung động (Sẽ được HTMX cập nhật) -->
        <div id="dashboard-content">
            <div style="margin-bottom: 1.5rem;">
                <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-color); display: flex; align-items: center; gap: 0.5rem;">
                    <i data-lucide="line-chart" style="color: #e11d48;"></i>
                    Thống kê hiệu quả <%= selectedDate ? 'ngày ' + new Date(selectedDate).toLocaleDateString('vi-VN') : 'tất cả các ngày' %>
                </h3>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color);">
                        <i data-lucide="book-open"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Tổng bài viết</h3>
                        <p><%= totalArticles %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--secondary-color);">
                        <i data-lucide="eye"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Lượt xem</h3>
                        <p><%= stats.totalViews.toLocaleString() %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(236, 72, 153, 0.1); color: #ec4899;">
                        <i data-lucide="mouse-pointer-click"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Lượt Click Link</h3>
                        <p><%= stats.totalClicks.toLocaleString() %></p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i data-lucide="trending-up"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Tỉ lệ CTR</h3>
                        <p><%= stats.totalViews > 0 ? ((stats.totalClicks / stats.totalViews) * 100).toFixed(1) : 0 %>%</p>
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
                <div class="admin-card" style="margin-bottom: 0; padding: 2rem;">
                    <h3 style="font-size: 1.2rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="bar-chart-2" style="color: var(--primary-color);"></i> Top Xem Nhiều <%= selectedDate ? '(Trong ngày)' : '(Tổng)' %>
                    </h3>
                    <ul style="list-style: none;">
                        <% if (stats.topViewed.length > 0) { %>
                            <% stats.topViewed.forEach((post, index) => { %>
                            <li style="padding: 1rem 0; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 600; font-size: 0.95rem; display: flex; align-items: center; gap: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280px;">
                                    <span style="color: var(--text-muted); font-family: monospace;"><%= index + 1 %>.</span> 
                                    <%= post.title %>
                                </span>
                                <span style="background: #f8fafc; padding: 4px 10px; border-radius: 8px; font-size: 0.85rem; font-weight: 700; color: var(--primary-color);">
                                    <%= post.views.toLocaleString() %> <span style="font-weight: 500; font-size: 0.75rem;">view</span>
                                </span>
                            </li>
                            <% }) %>
                        <% } else { %>
                            <p style="text-align: center; color: var(--text-muted); padding: 2rem;">Không có dữ liệu cho ngày này.</p>
                        <% } %>
                    </ul>
                </div>

                <div class="admin-card" style="margin-bottom: 0; padding: 2rem;">
                    <h3 style="font-size: 1.2rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i data-lucide="shopping-bag" style="color: #ec4899;"></i> Hiệu quả nhất <%= selectedDate ? '(Trong ngày)' : '(Tổng)' %>
                    </h3>
                    <ul style="list-style: none;">
                        <% if (stats.topClicked.length > 0) { %>
                            <% stats.topClicked.forEach((post, index) => { %>
                            <li style="padding: 1rem 0; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 600; font-size: 0.95rem; display: flex; align-items: center; gap: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280px;">
                                    <span style="color: var(--text-muted); font-family: monospace;"><%= index + 1 %>.</span> 
                                    <%= post.title %>
                                </span>
                                <span style="background: #fff1f2; padding: 4px 10px; border-radius: 8px; font-size: 0.85rem; font-weight: 700; color: #e11d48;">
                                    <%= post.affiliate_clicks.toLocaleString() %> <span style="font-weight: 500; font-size: 0.75rem;">click</span>
                                </span>
                            </li>
                            <% }) %>
                        <% } else { %>
                            <p style="text-align: center; color: var(--text-muted); padding: 2rem;">Không có dữ liệu cho ngày này.</p>
                        <% } %>
                    </ul>
                </div>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success">
                    <i data-lucide="check-circle"></i> 
                    <%= success === 'created' ? 'Đã tạo bài viết thành công!' : 
                        success === 'updated' ? 'Đã cập nhật bài viết thành công!' : 
                        'Đã xóa bài viết thành công!' %>
                </div>
            <% } %>

            <div class="admin-card" style="overflow-x: auto;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2.5rem;">
                    <h3 style="font-size: 1.4rem; font-weight: 800;">Danh sách bài viết</h3>
                    <a href="/admin/new" class="btn btn-primary">
                        <i data-lucide="plus"></i> <span class="hide-mobile">Viết bài mới</span>
                    </a>
                </div>
                
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th class="hide-mobile" style="width: 80px;">Ảnh</th>
                            <th style="min-width: 210px;">Tiêu đề bài viết</th>
                            <th style="width: 160px; white-space: nowrap;">Thống kê bài viết</th>
                            <th style="width: 130px;">Trạng thái</th>
                            <th class="hide-mobile" style="width: 160px;">Ngày đăng</th>
                            <th style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (articles.length > 0) { %>
                            <% articles.forEach(function(article) { %>
                                <tr>
                                    <td class="hide-mobile">
                                        <% if (article.thumbnail) { %>
                                            <img src="<%= article.thumbnail %>" alt="" class="thumb-preview">
                                        <% } else { %>
                                            <div class="thumb-preview" style="background:#f3f4f6; display:flex; align-items:center; justify-content:center; color:var(--text-muted);">
                                                <i data-lucide="image" size="20"></i>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <div style="font-weight: 700; color: var(--text-color); margin-bottom: 0.25rem; line-height: 1.4;"><%= article.title %></div>
                                        <div style="font-size: 0.8rem; color: var(--text-muted); font-family: monospace;"><%= article.slug %></div>
                                    </td>
                                    <td style="vertical-align: middle; white-space: nowrap;">
                                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); display: flex; align-items: center; gap: 0.4rem;">
                                            <i data-lucide="eye" size="14"></i> <%= article.views.toLocaleString() %> <span style="font-weight: 400; opacity: 0.7;">xem</span>
                                        </div>
                                        <div style="font-size: 0.85rem; font-weight: 600; color: #ec4899; display: flex; align-items: center; gap: 0.4rem; margin-top: 0.25rem;">
                                            <i data-lucide="mouse-pointer-click" size="14"></i> <%= article.affiliate_clicks.toLocaleString() %> <span style="font-weight: 400; opacity: 0.7;">click</span>
                                        </div>
                                    </td>
                                    <td style="vertical-align: middle; white-space: nowrap;">
                                        <button class="badge <%= article.status === 'active' ? 'badge-success' : '' %>" 
                                                style="<%= article.status !== 'active' ? 'background: #f3f4f6; color: var(--text-muted);' : '' %> white-space: nowrap; border: none; cursor: pointer; display: block; width: 100%; text-align: center;"
                                                hx-post="/admin/toggle-status/<%= article.id %>"
                                                hx-target="#dashboard-content"
                                                hx-select="#dashboard-content"
                                                hx-swap="outerHTML"
                                                hx-push-url="false"
                                                title="Nhấn để đổi trạng thái">
                                            <% if (article.status === 'active') { %>
                                                <i data-lucide="check" size="12" style="vertical-align: middle;"></i> Hoạt động
                                            <% } else { %>
                                                <i data-lucide="eye-off" size="12" style="vertical-align: middle;"></i> Đang ẩn
                                            <% } %>
                                        </button>
                                    </td>
                                    <td style="font-weight: 600; color: var(--text-muted);" class="hide-mobile"><%= new Date(article.created_at).toLocaleDateString('vi-VN') %></td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="/post/<%= article.slug %>" target="_blank" class="btn-action btn-view" title="Xem bài viết"><i data-lucide="eye" size="18"></i></a>
                                            <a href="/admin/edit/<%= article.id %>" class="btn-action btn-edit" title="Sửa bài viết"><i data-lucide="edit-3" size="18"></i></a>
                                            <form action="/admin/delete/<%= article.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?')">
                                                <button type="submit" class="btn-action btn-delete" title="Xóa bài viết"><i data-lucide="trash-2" size="18"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                                    <i data-lucide="inbox" size="40" style="margin-bottom: 1rem; opacity: 0.5;"></i>
                                    <p>Chưa có bài viết nào ở trang này.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>

                <!-- Phân trang -->
                <% if (totalPages > 1) { %>
                <div style="margin-top: 2.5rem; display: flex; justify-content: center; gap: 0.5rem;" class="pagination">
                    <% if (page > 1) { %>
                        <button class="btn-page" 
                                hx-get="/admin/dashboard?page=<%= page - 1 %>" 
                                hx-target="#dashboard-content" 
                                hx-select="#dashboard-content"
                                hx-swap="outerHTML">
                            <i data-lucide="chevron-left" size="18"></i>
                        </button>
                    <% } %>

                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <button class="btn-page <%= i === page ? 'active' : '' %>"
                                hx-get="/admin/dashboard?page=<%= i %>" 
                                hx-target="#dashboard-content" 
                                hx-select="#dashboard-content"
                                hx-swap="outerHTML">
                            <%= i %>
                        </button>
                    <% } %>

                    <% if (page < totalPages) { %>
                        <button class="btn-page"
                                hx-get="/admin/dashboard?page=<%= page + 1 %>" 
                                hx-target="#dashboard-content" 
                                hx-select="#dashboard-content"
                                hx-swap="outerHTML">
                            <i data-lucide="chevron-right" size="18"></i>
                        </button>
                    <% } %>
                </div>
                <% } %>
            </div>
        </div>

<% if (!onlyContent) { %>
    </main>

    <script>
        lucide.createIcons();

        // Admin sidebar toggle
        const toggleBtn = document.getElementById('admin-toggle-btn');
        const sidebar = document.getElementById('admin-sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.add('sidebar-open');
                overlay.classList.add('active');
            });
        }

        if (overlay) {
            overlay.addEventListener('click', () => {
                sidebar.classList.remove('sidebar-open');
                overlay.classList.remove('active');
            });
        }

        // Tự động re-init Lucide icon sau khi HTMX swap xong
        document.body.addEventListener('htmx:afterOnLoad', function() {
            lucide.createIcons();
        });
    </script>
</body>
</html>
<% } %>