<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Admin Panel</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --admin-sidebar-width: 280px;
        }

        body.admin-body {
            background: var(--bg-color);
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: var(--admin-sidebar-width);
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            color: white;
            position: fixed;
            height: 100vh;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-brand {
            padding: 2.5rem 2rem;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary-light);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .sidebar-menu {
            list-style: none;
            padding: 1rem 1.25rem;
            flex-grow: 1;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 12px;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .sidebar-menu a:hover, .sidebar-menu a.active {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        .sidebar-menu a.active {
            background: var(--primary-color);
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
        }

        .sidebar-footer {
            padding: 2rem 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: #fb7185;
            text-decoration: none;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.2s;
        }

        .logout-link:hover {
            background: rgba(251, 113, 133, 0.1);
        }

        /* Main Content */
        .admin-main {
            flex-grow: 1;
            margin-left: var(--admin-sidebar-width);
            padding: 3rem;
            width: 100%;
        }

        .admin-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
        }

        .admin-topbar h2 {
            font-size: 1.8rem;
            font-weight: 800;
        }

        .admin-card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 2.5rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
            border: 1px solid rgba(0, 0, 0, 0.03);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .stat-card {
            background: var(--white);
            padding: 2rem;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(0, 0, 0, 0.03);
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1.5rem;
        }

        .stat-info h3 {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .stat-info p {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--text-color);
        }

        .thumb-preview {
            width: 80px;
            height: 50px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
        }

        .admin-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 0.75rem;
        }

        .admin-table th {
            text-align: left;
            padding: 1rem 1.5rem;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .admin-table tr:not(thead tr) {
            background: var(--white);
            transition: all 0.2s;
        }

        .admin-table td {
            padding: 1.25rem 1.5rem;
            border-top: 1px solid #f3f4f6;
            border-bottom: 1px solid #f3f4f6;
        }

        .admin-table td:first-child {
            border-left: 1px solid #f3f4f6;
            border-radius: 16px 0 0 16px;
        }

        .admin-table td:last-child {
            border-right: 1px solid #f3f4f6;
            border-radius: 0 16px 16px 0;
        }

        .badge {
            padding: 0.5rem 1rem;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .badge-success { 
            background: #dcfce7; 
            color: #166534; 
        }

        .action-buttons {
            display: flex;
            gap: 0.75rem;
        }

        .btn-action {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-view { background: #f3f4f6; color: var(--text-color); }
        .btn-edit { background: rgba(99, 102, 241, 0.1); color: var(--primary-color); }
        .btn-delete { background: rgba(244, 63, 94, 0.1); color: #f43f5e; }

        .btn-action:hover {
            transform: scale(1.1);
        }

        .btn-primary {
            background: var(--primary-color);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 15px 25px rgba(99, 102, 241, 0.3);
        }

        .alert {
            padding: 1.25rem 2rem;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            gap: 1rem;
            font-weight: 600;
            margin-bottom: 2rem;
        }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        @media (max-width: 1024px) {
            .admin-sidebar { 
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .admin-sidebar.sidebar-open {
                transform: translateX(0);
            }
            .admin-main { margin-left: 0; padding: 1.5rem; }
        }

        .admin-toggle-btn {
            display: none;
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: white;
            color: var(--text-color);
            align-items: center;
            justify-content: center;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            z-index: 990;
        }

        .sidebar-overlay.active { display: block; }

        @media (max-width: 1024px) {
            .admin-toggle-btn { display: flex; }
        }
    </style>
</head>
<body class="admin-body">
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="sidebar-brand">
            <i data-lucide="sparkles"></i> <span>PurePick Admin</span>
        </div>
        <nav class="sidebar-menu">
            <a href="/admin/dashboard" class="active">
                <i data-lucide="layout-dashboard"></i> <span>Dashboard</span>
            </a>
            <a href="/admin/new">
                <i data-lucide="plus-circle"></i> <span>Viết bài mới</span>
            </a>
            <a href="/" target="_blank">
                <i data-lucide="external-link"></i> <span>Xem Website</span>
            </a>
        </nav>
        <div class="sidebar-footer">
            <a href="/admin/logout" class="logout-link">
                <i data-lucide="log-out"></i> <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-topbar">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button class="admin-toggle-btn" id="admin-toggle-btn">
                    <i data-lucide="menu"></i>
                </button>
                <h2>Hệ thống quản lý PurePick</h2>
            </div>
            <div class="user-info" style="display: flex; align-items: center; gap: 1rem;">
                <div style="text-align: right;" class="hide-mobile">
                    <div style="font-weight: 700; color: var(--text-color);">Quản trị viên</div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">Cấp cao</div>
                </div>
                <div style="width: 45px; height: 45px; border-radius: 12px; background: var(--primary-color); display: flex; align-items: center; justify-content: center; color: white;">
                    <i data-lucide="shield-check"></i>
                </div>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i data-lucide="book-open"></i></div>
                <div class="stat-info">
                    <h3>Tổng bài viết</h3>
                    <p><%= totalArticles %></p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i data-lucide="zap"></i></div>
                <div class="stat-info">
                    <h3>Trạng thái hệ thống</h3>
                    <p><span class="badge badge-success">Ổn định</span></p>
                </div>
            </div>
        </div>

        <% if (success) { %>
            <div class="alert alert-success">
                <i data-lucide="check-circle"></i> 
                <%= success === 'created' ? 'Đã tạo bài viết thành công!' : 
                    success === 'updated' ? 'Đã cập nhật bài viết thành công!' : 
                    'Đã xóa bài viết thành công!' %>
            </div>
        <% } %>

        <div class="admin-card" style="overflow-x: auto;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2.5rem;">
                <h3 style="font-size: 1.4rem; font-weight: 800;">Danh sách bài viết</h3>
                <a href="/admin/new" class="btn btn-primary">
                    <i data-lucide="plus"></i> <span class="hide-mobile">Viết bài mới</span>
                </a>
            </div>
            
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="hide-mobile">Ảnh</th>
                        <th>Tiêu đề bài viết</th>
                        <th>Trạng thái</th>
                        <th class="hide-mobile">Ngày đăng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (articles.length > 0) { %>
                        <% articles.forEach(function(article) { %>
                            <tr>
                                <td class="hide-mobile">
                                    <% if (article.thumbnail) { %>
                                        <img src="<%= article.thumbnail %>" alt="" class="thumb-preview">
                                    <% } else { %>
                                        <div class="thumb-preview" style="background:#f3f4f6; display:flex; align-items:center; justify-content:center; color:var(--text-muted);">
                                            <i data-lucide="image" size="20"></i>
                                        </div>
                                    <% } %>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: var(--text-color); margin-bottom: 0.25rem;"><%= article.title %></div>
                                    <div style="font-size: 0.85rem; color: var(--text-muted);"><%= article.slug %></div>
                                </td>
                                <td>
                                    <% if (article.status === 'active') { %>
                                        <span class="badge badge-success">Hoạt động</span>
                                    <% } else { %>
                                        <span class="badge" style="background: #f3f4f6; color: var(--text-muted);">Đang ẩn</span>
                                    <% } %>
                                </td>
                                <td style="font-weight: 600; color: var(--text-muted);" class="hide-mobile"><%= new Date(article.created_at).toLocaleDateString('vi-VN') %></td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/post/<%= article.slug %>" target="_blank" class="btn-action btn-view" title="Xem bài viết"><i data-lucide="eye" size="18"></i></a>
                                        <a href="/admin/edit/<%= article.id %>" class="btn-action btn-edit" title="Sửa bài viết"><i data-lucide="edit-3" size="18"></i></a>
                                        <form action="/admin/delete/<%= article.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?')">
                                            <button type="submit" class="btn-action btn-delete" title="Xóa bài viết"><i data-lucide="trash-2" size="18"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                                <i data-lucide="inbox" size="40" style="margin-bottom: 1rem; opacity: 0.5;"></i>
                                <p>Chưa có bài viết nào. Hãy bắt đầu tạo nội dung mới!</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <style>
        @media (max-width: 640px) {
            .hide-mobile { display: none !important; }
        }
    </style>

    <script>
        lucide.createIcons();

        // Admin sidebar toggle
        const toggleBtn = document.getElementById('admin-toggle-btn');
        const sidebar = document.getElementById('admin-sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.add('sidebar-open');
                overlay.classList.add('active');
            });
        }

        if (overlay) {
            overlay.addEventListener('click', () => {
                sidebar.classList.remove('sidebar-open');
                overlay.classList.remove('active');
            });
        }
    </script>
</body>
</html>