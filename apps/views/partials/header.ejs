<!DOCTYPE html>
<html lang="vi">

<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
                <%= typeof title !=='undefined' ? title : 'PurePick - Review Mỹ phẩm Chuyên sâu' %>
        </title>
        <link rel="stylesheet" href="/css/style.css">
        <% if (typeof description !=='undefined' ) { %>
                <meta name="description" content="<%= description %>">
                <% } %>
        <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest"></script>
        <!-- HTMX for SPA transitions -->
        <script src="https://unpkg.com/htmx.org@1.9.10"></script>
        <!-- NProgress for loading bar -->
        <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
        <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css" />
        <style>
            #nprogress .bar { background: var(--primary-color) !important; height: 3px !important; }
            #nprogress .peg { box-shadow: 0 0 10px var(--primary-color), 0 0 5px var(--primary-color) !important; }
            #nprogress .spinner-icon { border-top-color: var(--primary-color) !important; border-left-color: var(--primary-color) !important; }
        </style>
</head>

<body hx-boost="true">
        <header class="site-header" id="site-header" hx-preserve="true">
                <div class="container">
                        <nav class="navbar">
                                <a href="/" class="logo">
                                        <i data-lucide="sparkles"></i>
                                        <span>PurePick</span>
                                </a>
                                <button class="mobile-menu-btn" id="mobile-menu-btn">
                                        <i data-lucide="menu"></i>
                                </button>
                                <ul class="nav-menu" id="nav-menu">
                                        <li><a href="/">Trang Chủ</a></li>
                                        <li><a href="/about">Giới Thiệu</a></li>
                                </ul>
                        </nav>
                </div>
        </header>

        <script>
                // HTMX Loading Bar
                document.addEventListener('htmx:sendStart', () => NProgress.start());
                document.addEventListener('htmx:afterSettle', () => NProgress.done());
                document.addEventListener('htmx:sendError', () => NProgress.done());

                // Enable View Transitions
                htmx.config.globalViewTransitions = true;

                // CHỐNG CHỚP: Tắt View Transition của trình duyệt khi Lọc bài viết
                // (Chỉ dùng View Transition cho việc chuyển trang toàn bộ)
                document.addEventListener('htmx:beforeTransition', function(evt) {
                    if (evt.detail.target && evt.detail.target.id === 'search-results') {
                        evt.preventDefault(); // Chặn trình duyệt snapshot toàn trang
                    }
                });

                // Mobile menu toggle logic
                function initMobileMenu() {
                        const menuBtn = document.getElementById('mobile-menu-btn');
                        const navMenu = document.getElementById('nav-menu');

                        if (menuBtn && navMenu) {
                                const newMenuBtn = menuBtn.cloneNode(true);
                                menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);

                                newMenuBtn.addEventListener('click', () => {
                                        navMenu.classList.toggle('active');
                                        if (navMenu.classList.contains('active')) {
                                                newMenuBtn.innerHTML = '<i data-lucide="x"></i>';
                                        } else {
                                                newMenuBtn.innerHTML = '<i data-lucide="menu"></i>';
                                        }
                                        lucide.createIcons();
                                });
                        }
                }

                // Custom Select Initialization
                function initCustomSelects() {
                    document.querySelectorAll('.custom-select-wrapper').forEach(wrapper => {
                        const trigger = wrapper.querySelector('.custom-select-trigger-unified');
                        const optionsList = wrapper.querySelector('.custom-options-list');
                        const hiddenInput = wrapper.querySelector('input[type="hidden"]');
                        const options = wrapper.querySelectorAll('.custom-option');

                        if (!trigger || !hiddenInput) return;

                        // Gỡ bỏ event listener cũ nếu có (để tránh lặp)
                        const newTrigger = trigger.cloneNode(true);
                        trigger.parentNode.replaceChild(newTrigger, trigger);

                        newTrigger.addEventListener('click', (e) => {
                            e.stopPropagation();
                            document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                                if (w !== wrapper) w.classList.remove('open');
                            });
                            wrapper.classList.toggle('open');
                        });

                        options.forEach(opt => {
                            opt.addEventListener('click', (e) => {
                                e.stopPropagation();
                                const value = opt.getAttribute('data-value');
                                const text = opt.innerText;

                                newTrigger.querySelector('span').innerText = text;
                                options.forEach(o => o.classList.remove('selected'));
                                opt.classList.add('selected');
                                
                                hiddenInput.value = value;
                                wrapper.classList.remove('open');
                                
                                htmx.trigger('#filter-form', 'submit');
                            });
                        });
                    });

                    // Đóng menu khi click ra ngoài
                    document.removeEventListener('click', closeAllSelects);
                    document.addEventListener('click', closeAllSelects);
                }

                function closeAllSelects() {
                    document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
                }

                document.addEventListener('DOMContentLoaded', () => {
                    initMobileMenu();
                    initCustomSelects();
                });
                
                document.addEventListener('htmx:afterSettle', () => {
                    initMobileMenu();
                    initCustomSelects();
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                });
        </script>
        <main>