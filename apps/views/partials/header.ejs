<!DOCTYPE html>
<html lang="vi">

<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>
                <%= typeof title !=='undefined' ? title : 'PurePick - Review Mỹ phẩm Chuyên sâu' %>
        </title>
        <!-- Core Styles -->
        <link rel="stylesheet" href="/css/style.css">
        <!-- Auth Modal Styles -->
        <link rel="stylesheet" href="/css/auth-modal.css">
        <!-- Post Specific Styles (Preloaded for SPA) -->
        <link href="/css/post-detail.css" rel="stylesheet">
        <!-- Quill 2.0 Rich Text Editor CSS (Preloaded for SPA) -->
        <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
        <!-- Responsive Mobile Styles -->
        <link rel="stylesheet" href="/css/mobile.css">
        <% if (typeof description !=='undefined' ) { %>
                <meta name="description" content="<%= description %>">
                <% } %>
        <!-- Lucide Icons -->
        <script src="https://unpkg.com/lucide@latest"></script>
        <!-- HTMX for SPA transitions -->
        <script src="https://unpkg.com/htmx.org@1.9.10"></script>
        <!-- Socket.io for Real-time Notifications -->
        <script src="/socket.io/socket.io.js"></script>
        <script>
            // Khởi tạo kết nối Socket.io toàn cục
            if (!window.appSocket) {
                window.appSocket = io();
                
                window.appSocket.on('newNotification', (data) => {
                    // Kích hoạt sự kiện để HTMX tự động cập nhật badge và danh sách
                    htmx.trigger(document.body, 'refresh-notif-badge');
                    
                    // Nếu dropdown đang mở, tự động cập nhật danh sách
                    const notifDropdown = document.getElementById('notifications-dropdown');
                    if (notifDropdown && notifDropdown.classList.contains('active')) {
                        htmx.trigger('#notifications-list', 'refresh-list');
                    }

                    // Tùy chọn: Thêm hiệu ứng rung cho chuông để gây chú ý
                    const bellIcon = document.querySelector('.notifications-btn i');
                    if (bellIcon) {
                        bellIcon.classList.add('lucide-shake');
                        setTimeout(() => bellIcon.classList.remove('lucide-shake'), 1000);
                    }

                    // Hiển thị Toast
                    if (data && data.actor_name) {
                        showToast(data);
                    }
                });
            }

            // Đảm bảo Socket.io nhận diện đúng Session mới sau khi HTMX swap (Đăng nhập/Đăng xuất)
            function reconnectSocket() {
                if (window.appSocket) {
                    console.log('Reconnecting socket to pick up new session...');
                    window.appSocket.disconnect();
                    setTimeout(() => {
                        window.appSocket.connect();
                    }, 200); // Đợi thêm một chút để đảm bảo cookie đã được trình duyệt ghi nhận hoàn toàn
                }
            }

            document.addEventListener('htmx:afterSettle', (e) => {
                const target = e.detail.target;
                if (target && (target.tagName === 'BODY' || target.id === 'site-header')) {
                    reconnectSocket();
                }
            });

            // Lắng nghe trigger đặc biệt từ server
            document.body.addEventListener('refresh-socket', reconnectSocket);

            function showToast(data) {
                let container = document.getElementById('toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'toast-container';
                    document.body.appendChild(container);
                }

                const toast = document.createElement('div');
                toast.className = 'toast-item';
                
                const actionText = data.type === 'like_comment' ? 'đã thích bình luận của bạn.' : 'đã trả lời bình luận của bạn.';
                
                toast.innerHTML = `
                    <img src="${data.actor_avatar}" alt="Avatar" class="toast-avatar">
                    <div class="toast-content">
                        <p><strong>${data.actor_name}</strong> ${actionText}</p>
                    </div>
                    <div class="toast-progress"></div>
                `;

                // Click để mở danh sách thông báo
                toast.addEventListener('click', () => {
                    const notifBtn = document.querySelector('.notifications-btn');
                    const dropdown = document.getElementById('notifications-dropdown');
                    if (notifBtn && dropdown && !dropdown.classList.contains('active')) {
                        notifBtn.click();
                    }
                    toast.classList.add('fade-out');
                });

                container.appendChild(toast);

                // Tự động xóa sau 5 giây
                setTimeout(() => {
                    if (!toast.classList.contains('fade-out')) {
                        toast.classList.add('fade-out');
                        setTimeout(() => toast.remove(), 400); // Đợi animation kết thúc
                    }
                }, 5000);
            }
        </script>
        <!-- NProgress for loading bar -->
        <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
        <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css" />
        <style>
            #nprogress .bar { background: var(--primary-color) !important; height: 3px !important; }
            #nprogress .peg { box-shadow: 0 0 10px var(--primary-color), 0 0 5px var(--primary-color) !important; }
            #nprogress .spinner-icon { border-top-color: var(--primary-color) !important; border-left-color: var(--primary-color) !important; }
        </style>
</head>

<body hx-boost="true">
        <header class="site-header" id="site-header">
                <div class="container">
                        <nav class="navbar">
                                <button class="mobile-menu-btn" id="mobile-menu-btn">
                                    <i data-lucide="menu"></i>
                                </button>
                                <a href="/" class="logo">
                                        <i data-lucide="sparkles"></i>
                                        <span>PurePick</span>
                                </a>
                                
                                <ul class="nav-menu" id="nav-menu">
                                        <div class="nav-indicator" id="nav-indicator"></div>
                                        <li><a href="/" class="nav-link">Trang Chủ</a></li>
                                        <li><a href="/about" class="nav-link">Giới Thiệu</a></li>
                                </ul>

                                <div class="user-actions">
                                        <% if (locals.user) { %>
                                            <!-- Notifications -->
                                            <div class="notifications-wrapper" id="notifications-wrapper">
                                                <button class="notifications-btn" 
                                                        onclick="toggleNotifications(event)"
                                                        hx-get="/api/notifications/unread-count" 
                                                        hx-trigger="load, refresh-notif-badge from:body" 
                                                        hx-target=".notification-badge">
                                                    <i data-lucide="bell" size="20"></i>
                                                    <span class="notification-badge"></span>
                                                </button>
                                                <div class="notifications-dropdown" id="notifications-dropdown">
                                                    <div class="notifications-header">
                                                        <h3>Thông báo</h3>
                                                        <button class="mark-all-read" 
                                                                hx-post="/api/notifications/read-all" 
                                                                hx-swap="none" 
                                                                onclick="setTimeout(() => htmx.trigger('#notifications-list', 'refresh-list'), 100)">
                                                            Đánh dấu đã đọc
                                                        </button>
                                                    </div>
                                                    <div class="notifications-list" id="notifications-list" 
                                                         hx-get="/api/notifications" 
                                                         hx-trigger="click from:.notifications-btn, refresh-list">
                                                        <div class="notification-empty">
                                                            <div class="animate-spin" style="margin-bottom: 1rem;"><i data-lucide="loader-2" size="24"></i></div>
                                                            <p>Đang tải...</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="user-profile-wrapper" id="user-profile-wrapper">
                                                <button class="user-profile-btn" onclick="toggleUserDropdown(event)">
                                                    <img src="<%= locals.user.avatar_url %>" alt="Avatar" class="user-avatar">
                                                </button>
                                                <div class="user-dropdown" id="user-dropdown">
                                                    <a href="/profile" class="user-dropdown-header">
                                                        <img src="<%= locals.user.avatar_url %>" alt="Avatar" class="user-avatar-large">
                                                        <div class="user-info">
                                                            <strong><%= locals.user.full_name || locals.user.username %></strong>
                                                            <span>@<%= locals.user.username %></span>
                                                        </div>
                                                        <i data-lucide="chevron-right" size="16" style="margin-left: auto; color: var(--text-muted);"></i>
                                                    </a>
                                                    <a href="/saved" class="dropdown-item"><i data-lucide="bookmark" size="16"></i> Đã lưu</a>
                                                    <div class="dropdown-divider"></div>
                                                    <a href="/auth/logout" class="dropdown-item logout"><i data-lucide="log-out" size="16"></i> Đăng xuất</a>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <a href="javascript:void(0)" class="login-btn" onclick="openAuthModal()"><i data-lucide="user"></i> <span class="login-text">Đăng nhập</span></a>
                                        <% } %>
                                </div>
                        </nav>
                </div>
        </header>

        <script>
                // User Dropdown Logic
                function toggleUserDropdown(e) {
                    if (e) e.stopPropagation();
                    document.getElementById('user-dropdown').classList.toggle('active');
                    document.querySelector('.user-profile-btn').classList.toggle('active');
                    // Đóng dropdown thông báo nếu đang mở
                    const notifDropdown = document.getElementById('notifications-dropdown');
                    if (notifDropdown) notifDropdown.classList.remove('active');
                }

                // Notification Dropdown Logic
                function toggleNotifications(e) {
                    if (e) e.stopPropagation();
                    document.getElementById('notifications-dropdown').classList.toggle('active');
                    // Đóng dropdown user nếu đang mở
                    document.getElementById('user-dropdown').classList.remove('active');
                    document.querySelector('.user-profile-btn').classList.remove('active');
                }

                // Đóng dropdown khi click ra ngoài
                document.addEventListener('click', function(e) {
                    const dropdown = document.getElementById('user-dropdown');
                    const profileBtn = document.querySelector('.user-profile-btn');
                    if (dropdown && profileBtn && !dropdown.contains(e.target) && !profileBtn.contains(e.target)) {
                        dropdown.classList.remove('active');
                        profileBtn.classList.remove('active');
                    }

                    const notifDropdown = document.getElementById('notifications-dropdown');
                    const notifBtn = document.querySelector('.notifications-btn');
                    if (notifDropdown && notifBtn && !notifDropdown.contains(e.target) && !notifBtn.contains(e.target)) {
                        notifDropdown.classList.remove('active');
                    }
                });

                // Hàm di chuyển thanh Indicator
                function moveIndicator(link) {
                    const indicator = document.getElementById('nav-indicator');
                    if (link && indicator) {
                        indicator.style.width = `${link.offsetWidth}px`;
                        indicator.style.height = `${link.offsetHeight}px`;
                        const li = link.parentElement;
                        // Vị trí của thẻ li tương đối với ul (đã trừ padding)
                        indicator.style.transform = `translateX(${li.offsetLeft}px)`;
                        indicator.style.opacity = '1';
                    } else if (indicator) {
                        indicator.style.opacity = '0';
                    }
                }

                // Hàm cập nhật trạng thái Active cho Menu
                function updateActiveNav() {
                    const currentPath = window.location.pathname;
                    let activeLink = null;
                    document.querySelectorAll('.nav-menu .nav-link').forEach(link => {
                        const linkPath = link.getAttribute('href');
                        link.classList.remove('active');
                        if (linkPath === '/' && currentPath === '/') {
                            link.classList.add('active');
                            activeLink = link;
                        } else if (linkPath !== '/' && currentPath.startsWith(linkPath)) {
                            link.classList.add('active');
                            activeLink = link;
                        }

                        // Lắng nghe click để di chuyển ngay lập tức (như công tắc bật tắt)
                        link.addEventListener('click', function() {
                            document.querySelectorAll('.nav-menu .nav-link').forEach(l => l.classList.remove('active'));
                            this.classList.add('active');
                            moveIndicator(this);
                        });
                    });

                    // Khởi tạo vị trí ban đầu
                    setTimeout(() => moveIndicator(activeLink), 50);
                }
                // HTMX Loading Bar (Chỉ bật cho chuyển trang và lọc bài viết)
                document.addEventListener('htmx:sendStart', (evt) => {
                    const target = evt.detail.target;
                    if (target && (target.id === 'search-results' || target.tagName === 'BODY')) {
                        NProgress.start();
                    }
                });
                document.addEventListener('htmx:afterSettle', () => NProgress.done());
                document.addEventListener('htmx:sendError', () => NProgress.done());

                // Vô hiệu hóa View Transitions để tránh tình trạng giật lag khi chuyển trang
                htmx.config.globalViewTransitions = false;

                // CHỐNG LAG SCROLL: Cuộn lên đầu trang ngay sau khi DOM thay đổi, trước khi browser chụp ảnh mới
                document.addEventListener('htmx:afterSwap', function(evt) {
                    if (evt.detail.target === document.body) {
                        window.scrollTo(0, 0);
                    }
                });

                // Mobile menu toggle logic (SỬ DỤNG EVENT DELEGATION để chống liệt khi Back trang)
                if (!window.mobileMenuAttached) {
                    document.addEventListener('click', (e) => {
                        const menuBtn = e.target.closest('#mobile-menu-btn');
                        const navMenu = document.getElementById('nav-menu');
                        
                        if (menuBtn && navMenu) {
                            navMenu.classList.toggle('active');
                            if (navMenu.classList.contains('active')) {
                                menuBtn.innerHTML = '<i data-lucide="x"></i>';
                            } else {
                                menuBtn.innerHTML = '<i data-lucide="menu"></i>';
                            }
                            lucide.createIcons();
                        }
                    });
                    window.mobileMenuAttached = true;
                }

                // Custom Select Initialization
                function initCustomSelects() {
                    document.querySelectorAll('.custom-select-wrapper').forEach(wrapper => {
                        const trigger = wrapper.querySelector('.custom-select-trigger-unified');
                        const optionsList = wrapper.querySelector('.custom-options-list');
                        const hiddenInput = wrapper.querySelector('input[type="hidden"]');
                        const options = wrapper.querySelectorAll('.custom-option');

                        if (!trigger || !hiddenInput) return;

                        // Gỡ bỏ event listener cũ nếu có (để tránh lặp)
                        const newTrigger = trigger.cloneNode(true);
                        trigger.parentNode.replaceChild(newTrigger, trigger);

                        newTrigger.addEventListener('click', (e) => {
                            e.stopPropagation();
                            document.querySelectorAll('.custom-select-wrapper').forEach(w => {
                                if (w !== wrapper) w.classList.remove('open');
                            });
                            wrapper.classList.toggle('open');
                        });

                        options.forEach(opt => {
                            opt.addEventListener('click', (e) => {
                                e.stopPropagation();
                                const value = opt.getAttribute('data-value');
                                const text = opt.innerText;

                                newTrigger.querySelector('span').innerText = text;
                                options.forEach(o => o.classList.remove('selected'));
                                opt.classList.add('selected');
                                
                                hiddenInput.value = value;
                                wrapper.classList.remove('open');
                                
                                htmx.trigger('#filter-form', 'submit');
                            });
                        });
                    });

                    // Đóng menu khi click ra ngoài
                    document.removeEventListener('click', closeAllSelects);
                    document.addEventListener('click', closeAllSelects);
                }

                function closeAllSelects() {
                    document.querySelectorAll('.custom-select-wrapper').forEach(w => w.classList.remove('open'));
                }

                document.addEventListener('DOMContentLoaded', () => {
                    initCustomSelects();
                    updateActiveNav();
                });
                
                document.addEventListener('htmx:afterSettle', () => {
                    initCustomSelects();
                    updateActiveNav();
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                });
        </script>
        <main>