<div class="comment-thread" id="thread-<%= comment.id %>">
    <%- include('comment-item', { comment: comment, isReply: false }) %>

    <!-- Vùng chứa Replies -->
    <div class="replies-container" id="replies-<%= comment.id %>">
        <% if (comment.replies && comment.replies.length > 0) { %>
            <% comment.replies.forEach(function(reply) { %>
                <%- include('comment-item', { comment: reply, isReply: true }) %>
            <% }); %>
        <% } %>

        <!-- Nút Load More Replies -->
        <% if (comment.total_replies > 2) { %>
            <button id="load-more-replies-<%= comment.id %>" class="btn-reply load-more-btn" style="margin-left: 3rem; margin-top: 0.5rem; display: flex; align-items: center; gap: 0.3rem;" hx-get="/api/comments/replies/<%= comment.id %>?offset=2" hx-target="this" hx-swap="outerHTML">
                <i data-lucide="corner-down-right" size="14"></i> Xem thêm <%= comment.total_replies - 2 %> phản hồi
            </button>
        <% } %>
        
        <!-- Form Phản hồi ẩn -->
        <% if (locals.user) { %>
        <div class="reply-form-container" id="reply-form-<%= comment.id %>" style="display: none; margin-top: 1rem;">
            <form class="comment-form reply-form" hx-post="/api/comments/<%= articleId %>" hx-swap="beforeend" hx-target="#replies-<%= comment.id %>" onsubmit="setTimeout(() => { this.reset(); toggleReplyForm(<%= comment.id %>); }, 10)">
                <input type="hidden" name="parent_id" value="<%= comment.id %>">
                <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                    <img src="<%= locals.user.avatar_url %>" alt="Avatar" class="comment-avatar" style="width: 36px; height: 36px;">
                    <div style="flex: 1; display: flex; flex-direction: column; gap: 0.5rem;">
                        <textarea name="content" placeholder="Viết phản hồi cho <%= comment.full_name || comment.username %>..." required rows="2"></textarea>
                        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                            <button type="button" class="btn-cancel" onclick="toggleReplyForm(<%= comment.id %>)">Hủy</button>
                            <button type="submit" class="btn-primary btn-sm" style="display: flex; align-items: center; gap: 0.3rem;">Gửi <i data-lucide="send" size="14"></i></button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <% } %>
    </div>
</div>