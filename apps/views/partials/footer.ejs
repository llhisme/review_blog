<script>
    function initFooter() {
        // Initialize Lucide icons
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    // SỬ DỤNG EVENT DELEGATION: Gán sự kiện click cho document
    // Cách này giúp nút hoạt động vĩnh viễn, kể cả khi dùng nút Back của trình duyệt
    if (!window.backToTopAttached) {
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('#back-to-top');
            if (btn) {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });
        window.backToTopAttached = true;
    }

    // Scroll event listener (luôn tồn tại trên window)
    if (!window.scrollListenerAttached) {
        window.addEventListener('scroll', () => {
            const btn = document.getElementById('back-to-top');
            if (btn) {
                if (window.pageYOffset > 300) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
        });
        window.scrollListenerAttached = true;
    }

    document.addEventListener('DOMContentLoaded', initFooter);
    document.addEventListener('htmx:afterSettle', initFooter);
    // Đảm bảo icon hiển thị đúng sau khi khôi phục lịch sử
    document.addEventListener('htmx:historyRestore', initFooter);
</script>

